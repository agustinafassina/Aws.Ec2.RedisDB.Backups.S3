# Config for generate-backup.sh and restore-backup.sh
# Install on the instance:
#   sudo cp redis-backup.env.example /etc/redis-backup.env
#   sudo chown ubuntu:ubuntu /etc/redis-backup.env && sudo chmod 600 /etc/redis-backup.env

# --- S3 ---
BACKUP_S3_BASE=s3://my-bucket/redis

# --- Redis (least-privilege ACL user: +ping +info +bgsave +lastsave) ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USER=backup
REDISCLI_AUTH=ChangeMe

# --- Backup options ---
#REDIS_DATA_DIR=/var/lib/redis
#BGSAVE_TIMEOUT=600
#REMOVE_LOCAL_AFTER_UPLOAD=true

# --- Failure alerts (optional, use one or both) ---
#ALERT_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
#ALERT_SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:redis-backup-alerts
